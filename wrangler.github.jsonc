{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botcollectdata",
  "main": "release/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "line-chat-archive-dashboard",
    "database_id": "db95a750-a7b2-4a51-a677-d006504ca022"
  }],
  // Runtime Text variables and Secrets are entered in Cloudflare Dashboard.
  // The deploy:github script uses --keep-vars to preserve them on every deploy.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
